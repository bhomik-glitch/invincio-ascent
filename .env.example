# Student logins: comma-separated phone:password pairs. Set these in Vercel → Project → Settings → Environment Variables.
AUTH_USERS=9876543210:changeme,9123456789:changeme2
# Random string used to sign the login cookie. Generate: openssl rand -hex 32
AUTH_SECRET=

# Payments — Razorpay Dashboard → Settings → API Keys (use rzp_test_* keys until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Settings → Webhooks → https://<site>/api/pay-webhook, event payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Invoice emails — resend.com → API Keys. INVOICE_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=Invincio <billing@invincioservices.com>
# Optional: get a copy of every invoice
INVOICE_BCC_EMAIL=
# Used to build the invoice link in the email
SITE_URL=https://www.invincioservices.com
